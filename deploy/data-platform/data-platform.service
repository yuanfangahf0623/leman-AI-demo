[Unit]
Description=Leman single-tenant data platform
After=network-online.target mysql.service data-center-seatunnel.service
Wants=network-online.target

[Service]
Type=simple
User=data-platform
Group=data-platform
WorkingDirectory=/opt/data-platform/current/app
EnvironmentFile=/opt/data-platform/shared/config/data-platform.env
ExecStart=/usr/lib/jvm/java-17-openjdk-amd64/bin/java -XX:MaxRAMPercentage=70 -Dfile.encoding=UTF-8 -jar /opt/data-platform/current/app/yudao-server.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/data-platform/shared /var/log/data-platform /opt/data-center/shared/seatunnel/apache-seatunnel-2.3.13/logs
StandardOutput=append:/var/log/data-platform/app/application.log
StandardError=append:/var/log/data-platform/app/application-error.log

[Install]
WantedBy=multi-user.target
