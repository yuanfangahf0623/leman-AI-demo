{
	admin off
	auto_https disable_redirects
}

# Knowledge base frontend owns port 80 directly. Port 8080 is kept as
# an alternate LAN entry that proxies to the frontend.
http://192.168.19.36:8080 {
	reverse_proxy 127.0.0.1:80
}

https://192.168.19.36 {
	tls internal
	reverse_proxy 127.0.0.1:5678
}

https://192.168.19.36:433 {
	tls internal
	reverse_proxy 127.0.0.1:5678
}

https://192.168.19.36:8443 {
	tls internal
	reverse_proxy 127.0.0.1:5678
}

https://n8n.leman-tech.com {
	reverse_proxy 127.0.0.1:5678
}

https://twohaohr.leman-tech.com {
	handle /open-api/ai/twohaohr/callback* {
		reverse_proxy 127.0.0.1:48080
	}

	handle {
		respond "Not Found" 404
	}
}
