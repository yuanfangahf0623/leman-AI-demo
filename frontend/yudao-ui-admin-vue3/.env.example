# Application title
VITE_APP_TITLE=理文科技AI管理系统

# Local dev port
VITE_PORT=80

# Open browser when running dev server
VITE_OPEN=true

# Feature switches
VITE_APP_TENANT_ENABLE=false
VITE_APP_CAPTCHA_ENABLE=true
VITE_APP_DOCALERT_ENABLE=true

# Default login hints for local development.
# Do not put real production accounts or passwords here.
VITE_APP_DEFAULT_LOGIN_TENANT=
VITE_APP_DEFAULT_LOGIN_USERNAME=
VITE_APP_DEFAULT_LOGIN_PASSWORD=

# API encryption settings. Fill real keys through local env files or deployment config.
VITE_APP_API_ENCRYPT_ENABLE=false
VITE_APP_API_ENCRYPT_HEADER=X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM=AES
VITE_APP_API_ENCRYPT_REQUEST_KEY=
VITE_APP_API_ENCRYPT_RESPONSE_KEY=

# Optional third-party keys. Do not commit real production keys.
VITE_APP_BAIDU_CODE=
VITE_BAIDU_MAP_KEY=
